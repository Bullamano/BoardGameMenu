<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Main">
  <grid id="27dc6" binding="MainPanel" layout-manager="GridLayoutManager" row-count="11" column-count="8" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="797" height="430"/>
    </constraints>
    <properties/>
    <border type="bevel-raised"/>
    <children>
      <component id="343e5" class="javax.swing.JTextField" binding="txtGameName">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="6" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <toolTipText value="The name of the board game."/>
        </properties>
      </component>
      <component id="276b5" class="javax.swing.JTextField" binding="txtGameDescription">
        <constraints>
          <grid row="7" column="1" row-span="1" col-span="6" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <toolTipText value="A short description of the game (number of players, style, how to play, etc.)"/>
        </properties>
      </component>
      <component id="3ac9e" class="javax.swing.JTextField" binding="txtGamePhotoPath">
        <constraints>
          <grid row="5" column="2" row-span="1" col-span="5" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <editable value="false"/>
          <toolTipText value="The path to the picture file that will represent the game."/>
        </properties>
      </component>
      <component id="ca6b8" class="javax.swing.JLabel" binding="lblBGAppTitle">
        <constraints>
          <grid row="0" column="1" row-span="2" col-span="4" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Board game menu creator"/>
        </properties>
      </component>
      <component id="977a5" class="javax.swing.JLabel" binding="lblGameDescription">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Game description"/>
        </properties>
      </component>
      <component id="b26b" class="javax.swing.JLabel" binding="lblGamePicture">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Game picture"/>
        </properties>
      </component>
      <component id="ad400" class="javax.swing.JLabel" binding="lblGameName">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Game name"/>
        </properties>
      </component>
      <component id="a37da" class="javax.swing.JButton" binding="btnChooseImage">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Choose image"/>
        </properties>
      </component>
      <grid id="81fdf" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="100" bottom="0" right="100"/>
        <constraints>
          <grid row="8" column="1" row-span="2" col-span="6" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="empty"/>
        <children>
          <component id="3d389" class="javax.swing.JButton" binding="btnAddGame">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Add game"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="7511e">
        <constraints>
          <grid row="0" column="7" row-span="8" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="209b5" class="javax.swing.JList" binding="lstAddedGames">
            <constraints/>
            <properties>
              <toolTipText value="List of registered board games"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="d45b7" class="javax.swing.JButton" binding="btnDeleteGame">
        <constraints>
          <grid row="8" column="7" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Delete game"/>
        </properties>
      </component>
      <component id="bede4" class="javax.swing.JButton" binding="btnGenerateFile">
        <constraints>
          <grid row="9" column="7" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Create PDF"/>
        </properties>
      </component>
      <grid id="f91ce" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="10" column="1" row-span="1" col-span="7" vsize-policy="0" hsize-policy="0" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <hspacer id="c8267">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <component id="4636a" class="javax.swing.JButton" binding="btnThanks" custom-create="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="..."/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
